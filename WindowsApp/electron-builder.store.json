{
  "appId": "com.vroomk.windows",
  "productName": "Vroomk",
  "copyright": "Copyright © Vroomk",
  "directories": {
    "output": "release-store",
    "buildResources": "assets"
  },
  "files": [
    "out/**/*",
    "viewer/**/*",
    "assets/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".env",
      "to": ".env"
    }
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "appx",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/logo2.png",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "appx": {
    "applicationId": "Vroomk",
    "identityName": "Vroomk.Vroomk",
    "publisher": "CN=D31AC5A3-5651-4B16-AE7B-07AB87B913E7",
    "publisherDisplayName": "Vroomk",
    "displayName": "Vroomk",
    "languages": ["en-US"],
    "showNameOnTiles": false,
    "setBuildNumber": false,
    "minVersion": "10.0.17763.0",
    "maxVersionTested": "10.0.22621.0",
    "backgroundColor": "#000000",
    "capabilities": ["runFullTrust", "internetClient"]
  }
}
